---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { type Lang, languages, localizePath, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
	title?: string;
	description?: string;
	/** URL of this page in other languages. Pages without one link to that language's home. */
	translations?: Partial<Record<Lang, string>>;
	article?: { published: Date; updated?: Date; tags: string[] };
}

const { lang, title, description, translations = {}, article } = Astro.props;
const t = useTranslations(lang);

const siteTitle = t('site.title');
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const metaDescription = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = { ...translations, [lang]: Astro.url.pathname } as Partial<Record<Lang, string>>;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<script is:inline>
			// Runs before paint so the page never flashes the wrong theme.
			(() => {
				let theme;
				try {
					theme = localStorage.getItem('theme');
				} catch {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>

		<title>{fullTitle}</title>
		<meta name="description" content={metaDescription} />
		<link rel="canonical" href={canonical} />
		{
			Object.entries(alternates).map(([l, href]) => (
				<link rel="alternate" hreflang={l} href={new URL(href, Astro.site)} />
			))
		}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={siteTitle}
			href={new URL(localizePath(lang, '/rss.xml'), Astro.site)}
		/>
		<meta name="generator" content={Astro.generator} />

		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:title" content={title ?? siteTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={languages[lang].locale.replace('-', '_')} />
		<meta property="og:type" content={article ? 'article' : 'website'} />
		{
			article && (
				<>
					<meta property="article:published_time" content={article.published.toISOString()} />
					{article.updated && (
						<meta property="article:modified_time" content={article.updated.toISOString()} />
					)}
					{article.tags.map((tag) => (
						<meta property="article:tag" content={tag} />
					))}
				</>
			)
		}
		<meta name="twitter:card" content="summary" />

		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-jetbrains-mono" />
	</head>
	<body>
		<Header lang={lang} translations={translations} />
		<main class="container">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
