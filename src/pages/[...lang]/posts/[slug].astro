---
import { getEntry, render } from 'astro:content';
import { formatDate, langParam, localizePath, useTranslations } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import {
	getPosts,
	getTranslations,
	type Post,
	postLang,
	postSlug,
	postUrl,
	readingTime,
	tagUrl,
} from '../../../lib/content';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { lang: langParam(postLang(post)), slug: postSlug(post) },
		props: { post },
	}));
}

interface Props {
	post: Post;
}

const { post } = Astro.props;
const lang = postLang(post);
const t = useTranslations(lang);
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);
const project = post.data.project ? await getEntry(post.data.project) : undefined;
const translations = Object.fromEntries((await getTranslations(post)).map((p) => [postLang(p), postUrl(p)]));
const { title, description, date, updated, tags } = post.data;
---

<Base
	lang={lang}
	title={title}
	description={description}
	translations={translations}
	article={{ published: date, updated, tags }}
>
	<header class="page-head">
		<h1 class="display">{title}</h1>
		<p class="lede">{description}</p>
	</header>

	<aside class="page-rail">
		<a class="label back" href={localizePath(lang, '/')}>← {t('post.back')}</a>
		<dl>
			<div>
				<dt class="label">{t('post.published')}</dt>
				<dd><time datetime={date.toISOString()}>{formatDate(date, lang)}</time></dd>
			</div>
			{
				updated && (
					<div>
						<dt class="label">{t('post.updated')}</dt>
						<dd>
							<time datetime={updated.toISOString()}>{formatDate(updated, lang)}</time>
						</dd>
					</div>
				)
			}
			<div>
				<dt class="label">{t('post.reading')}</dt>
				<dd>{t('post.minRead', { n: readingTime(post) })}</dd>
			</div>
			{
				project && (
					<div>
						<dt class="label">{t('post.project')}</dt>
						<dd>
							<a href={localizePath(lang, `/projects/${project.id}/`)}>{project.data.name}</a>
						</dd>
					</div>
				)
			}
		</dl>
		{
			Object.entries(translations).map(([l, href]) => (
				<a class="translation label" href={href} hreflang={l} lang={l}>
					{t('post.readIn')} →
				</a>
			))
		}
		{
			tags.length > 0 && (
				<ul class="tags">
					{tags.map((tag) => (
						<li>
							<a class="tag" href={tagUrl(lang, tag)}>
								{tag}
							</a>
						</li>
					))}
				</ul>
			)
		}
		{
			sections.length > 1 && (
				<nav class="toc" aria-labelledby="toc-title">
					<h2 class="label" id="toc-title">
						{t('post.contents')}
					</h2>
					<ol>
						{sections.map((section) => (
							<li>
								<a href={`#${section.slug}`}>{section.text}</a>
							</li>
						))}
					</ol>
				</nav>
			)
		}
	</aside>

	<article class="page-body prose">
		<Content />
	</article>
</Base>

<script>
	// Marks the section being read in the table of contents.
	const links = new Map(
		[...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [
			decodeURIComponent(a.hash.slice(1)),
			a,
		]),
	);
	const headings = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')].filter((h) => links.has(h.id));
	if (headings.length > 0) {
		const update = () => {
			const offset = window.innerHeight * 0.25;
			let current = headings[0];
			for (const heading of headings) {
				if (heading.getBoundingClientRect().top <= offset) current = heading;
			}
			for (const [id, link] of links) {
				link.toggleAttribute('aria-current', id === current.id);
			}
		};
		update();
		addEventListener('scroll', update, { passive: true });
	}
</script>

<style>
	.page-rail {
		display: grid;
		gap: 1.25rem;
		align-content: start;
		padding: 1rem 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.back {
		display: none;
		text-decoration: none;
	}

	dl {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
		gap: 1rem;
		margin: 0;
	}

	dd {
		margin: 0.125rem 0 0;
		font-size: 0.9375rem;
	}

	.translation {
		color: var(--marker);
		text-decoration: none;
	}

	.toc {
		display: none;
	}

	.toc ol {
		display: grid;
		gap: 0.125rem;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}

	.toc a {
		display: block;
		padding: 0.3rem 0 0.3rem 0.75rem;
		border-left: 1px solid var(--line);
		color: var(--sage);
		font-size: 0.875rem;
		line-height: 1.35;
		text-decoration: none;
	}

	.toc a:hover {
		color: var(--chalk);
	}

	.toc a[aria-current] {
		border-left-color: var(--marker);
		color: var(--chalk);
	}

	@media (min-width: 64rem) {
		.page-rail {
			gap: 1.75rem;
			padding: 0;
			border: 0;
		}

		.back,
		.toc {
			display: block;
		}

		dl {
			grid-template-columns: 1fr;
		}
	}
</style>
