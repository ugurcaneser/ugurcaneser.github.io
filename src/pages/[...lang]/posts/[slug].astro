---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import { formatDate, langParam, localizePath, useTranslations } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import {
	getPosts,
	getTranslations,
	type Post,
	postLang,
	postSlug,
	postUrl,
	readingTime,
	tagUrl,
} from '../../../lib/content';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { lang: langParam(postLang(post)), slug: postSlug(post) },
		props: { post },
	}));
}

interface Props {
	post: Post;
}

const { post } = Astro.props;
const lang = postLang(post);
const t = useTranslations(lang);
const { Content } = await render(post);
const project = post.data.project ? await getEntry(post.data.project) : undefined;
const translations = Object.fromEntries((await getTranslations(post)).map((p) => [postLang(p), postUrl(p)]));
const { title, description, date, updated, tags } = post.data;
---

<Base
	lang={lang}
	title={title}
	description={description}
	translations={translations}
	article={{ published: date, updated, tags }}
	image={project?.data.banner?.[lang] ?? project?.data.icon}
>
	<article>
		<header>
			{
				project && (
					<a class="project" href={localizePath(lang, `/projects/${project.id}/`)}>
						{project.data.icon && (
							<Image src={project.data.icon} alt="" width={24} height={24} densities={[1, 2]} />
						)}
						{project.data.name}
					</a>
				)
			}
			<h1 class="page-title">{title}</h1>
			<p class="meta muted">
				<time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
				<span>· {t('post.minRead', { n: readingTime(post) })}</span>
				{
					Object.entries(translations).map(([l, href]) => (
						<span>
							·{' '}
							<a href={href} hreflang={l} lang={l}>
								{t('post.readIn')}
							</a>
						</span>
					))
				}
			</p>
			{
				updated && (
					<p class="meta muted">
						{t('post.updated')} <time datetime={updated.toISOString()}>{formatDate(updated, lang)}</time>
					</p>
				)
			}
		</header>
		<div class="prose">
			<Content />
		</div>
		{
			tags.length > 0 && (
				<ul class="tags">
					{tags.map((tag) => (
						<li>
							<a href={tagUrl(lang, tag)}>{tag}</a>
						</li>
					))}
				</ul>
			)
		}
	</article>
</Base>

<style>
	header {
		margin-bottom: 2.5rem;
	}

	.project {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 2.5rem;
		color: var(--muted);
		font-size: 0.875rem;
		text-decoration: none;
	}

	.project:hover {
		color: var(--text);
	}

	.project img {
		border-radius: 22%;
	}

	.project + .page-title {
		margin-top: 0.75rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.35rem;
		margin: 0;
		font-size: 0.875rem;
	}

	.tags {
		margin-top: 3rem;
	}
</style>
