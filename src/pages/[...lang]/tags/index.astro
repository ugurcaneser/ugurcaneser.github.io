---
import { langFromParam, langPaths, useTranslations } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import { collectTags, getPosts, tagUrl } from '../../../lib/content';

export const getStaticPaths = langPaths;

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);
const tags = collectTags(await getPosts(lang));
---

<Base
	lang={lang}
	title={t('tags.title')}
	description={t('tags.description')}
	translations={{ en: '/tags/', tr: '/tr/tags/' }}
>
	<header class="page-head">
		<h1 class="display">{t('tags.title')}</h1>
		<p class="lede">{t('tags.description')}</p>
	</header>
	<div class="page-body">
		{
			tags.length === 0 ? (
				<p class="muted">{t('home.empty')}</p>
			) : (
				<ul class="tags">
					{tags.map((tag) => (
						<li>
							<a class="tag" href={tagUrl(lang, tag.name)}>
								{tag.name} <span>{tag.count}</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</Base>

<style>
	.tags {
		gap: 0.5rem;
	}

	.tag {
		padding: 0.4rem 0.75rem;
		font-size: 0.875rem;
	}

	.tag span {
		margin-left: 0.25rem;
		color: var(--marker);
	}
</style>
