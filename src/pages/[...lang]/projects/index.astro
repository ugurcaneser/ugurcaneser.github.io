---
import ProjectCard from '../../../components/ProjectCard.astro';
import { langFromParam, langPaths, useTranslations } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import { getPosts, getProjects } from '../../../lib/content';

export const getStaticPaths = langPaths;

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);
const posts = await getPosts(lang);
const projects = (await getProjects()).map((project) => {
	const count = posts.filter((post) => post.data.project?.id === project.id).length;
	return { project, count };
});
---

<Base
	lang={lang}
	title={t('projects.title')}
	description={t('projects.description')}
	translations={{ en: '/projects/', tr: '/tr/projects/' }}
>
	<h1 class="page-title">{t('projects.title')}</h1>
	<p class="page-description">{t('projects.description')}</p>
	<ul>
		{
			projects.map(({ project, count }) => (
				<li>
					<ProjectCard
						lang={lang}
						project={project}
						detailed
						note={count === 1 ? t('projects.postCountOne') : t('projects.postCount', { n: count })}
					/>
				</li>
			))
		}
	</ul>
</Base>

<style>
	ul {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
