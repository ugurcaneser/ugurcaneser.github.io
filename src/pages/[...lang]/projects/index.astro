---
import { Image } from 'astro:assets';
import { langFromParam, langPaths, localizePath, useTranslations } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import { getPosts, getProjects } from '../../../lib/content';

export const getStaticPaths = langPaths;

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);
const posts = await getPosts(lang);
const projects = (await getProjects()).map((project) => {
	const count = posts.filter((post) => post.data.project?.id === project.id).length;
	return { project, count };
});
---

<Base
	lang={lang}
	title={t('projects.title')}
	description={t('projects.description')}
	translations={{ en: '/projects/', tr: '/tr/projects/' }}
>
	<header class="page-head">
		<h1 class="display">{t('projects.title')}</h1>
		<p class="lede">{t('projects.description')}</p>
	</header>
	<ul class="page-body projects">
		{
			projects.map(({ project, count }) => (
				<li>
					<a href={localizePath(lang, `/projects/${project.id}/`)}>
						{project.data.icon ? (
							<Image src={project.data.icon} alt="" width={64} height={64} densities={[1, 2]} />
						) : (
							<span class="placeholder" aria-hidden="true">
								{project.data.name[0]}
							</span>
						)}
						<span class="name">{project.data.name}</span>
						<span class="description">{project.data.description[lang]}</span>
						<span class="label">
							{count === 1 ? t('projects.postCountOne') : t('projects.postCount', { n: count })}
						</span>
					</a>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.projects {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.projects a {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		column-gap: 1rem;
		row-gap: 0.25rem;
		height: 100%;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: 0.375rem;
		background: var(--mat);
		text-decoration: none;
	}

	.projects a:hover {
		border-color: var(--marker);
		color: inherit;
	}

	img,
	.placeholder {
		grid-row: span 3;
		width: 64px;
		height: 64px;
		border-radius: 0.875rem;
	}

	.placeholder {
		display: grid;
		place-items: center;
		background: var(--mat-raised);
		font-family: var(--font-display);
		font-size: 2rem;
	}

	.name {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 800;
		line-height: 1;
	}

	.projects a:hover .name {
		color: var(--marker);
	}

	.description {
		color: var(--sage);
		font-size: 0.9375rem;
		line-height: 1.5;
	}

	.label {
		margin-top: 0.5rem;
	}

	@media (min-width: 48rem) {
		.projects {
			grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
		}
	}
</style>
