---
import { Image } from 'astro:assets';
import PostList from '../../../components/PostList.astro';
import { langParam, langs, localizePath, useTranslations } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import { getPosts, getProjects, type Project } from '../../../lib/content';

export async function getStaticPaths() {
	const projects = await getProjects();
	return langs.flatMap((lang) =>
		projects.map((project) => ({
			params: { lang: langParam(lang), project: project.id },
			props: { lang, project },
		})),
	);
}

interface Props {
	lang: (typeof langs)[number];
	project: Project;
}

const { lang, project } = Astro.props;
const t = useTranslations(lang);
const { name, icon, description, links } = project.data;
const posts = (await getPosts(lang)).filter((post) => post.data.project?.id === project.id);
const translations = Object.fromEntries(langs.map((l) => [l, localizePath(l, `/projects/${project.id}/`)]));
---

<Base lang={lang} title={name} description={description[lang]} translations={translations}>
	<header class="page-head">
		{icon && <Image class="icon" src={icon} alt="" width={88} height={88} densities={[1, 2]} />}
		<h1 class="display">{name}</h1>
		<p class="lede">{description[lang]}</p>
	</header>
	{
		links.length > 0 && (
			<aside class="page-rail">
				<h2 class="label">{t('projects.links')}</h2>
				<ul>
					{links.map((link) => (
						<li>
							<a href={link.url}>{link.label[lang]} ↗</a>
						</li>
					))}
				</ul>
			</aside>
		)
	}
	<section class="page-body" aria-labelledby="project-posts">
		<h2 class="label heading" id="project-posts">{t('projects.posts')}</h2>
		<PostList lang={lang} posts={posts} hideProject />
	</section>
</Base>

<style>
	.icon {
		display: block;
		margin-bottom: 1.25rem;
		border-radius: 1.25rem;
	}

	.page-rail {
		display: grid;
		gap: 0.75rem;
		align-content: start;
	}

	.page-rail ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.heading {
		margin-bottom: 1rem;
	}

	@media (min-width: 64rem) {
		.page-rail ul {
			flex-direction: column;
		}
	}
</style>
