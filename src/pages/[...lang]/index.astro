---
import PostList from '../../components/PostList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { langFromParam, langPaths, useTranslations } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { getPosts, getProjects } from '../../lib/content';

export const getStaticPaths = langPaths;

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);
const posts = await getPosts(lang);
const projects = await getProjects();
---

<Base lang={lang} translations={{ en: '/', tr: '/tr/' }}>
	<p class="intro muted">{t('home.intro')}</p>

	<h2 class="section-title">{t('home.projects')}</h2>
	<ul class="projects">
		{
			projects.map((project) => (
				<li>
					<ProjectCard lang={lang} project={project} />
				</li>
			))
		}
	</ul>

	<h2 class="section-title">{t('nav.posts')}</h2>
	<PostList lang={lang} posts={posts} />
</Base>

<style>
	.intro {
		margin: 2rem 0 0;
		font-size: 1.125rem;
	}

	.projects {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 36rem) {
		.projects {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
