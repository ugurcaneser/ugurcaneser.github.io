---
import { Image } from 'astro:assets';
import { type Lang, localizePath } from '../i18n';
import type { Project } from '../lib/content';

interface Props {
	lang: Lang;
	projects: Project[];
}

const { lang, projects } = Astro.props;
---

<ul>
	{
		projects.map((project) => (
			<li>
				<a href={localizePath(lang, `/projects/${project.id}/`)}>
					{project.data.icon ? (
						<Image src={project.data.icon} alt="" width={28} height={28} densities={[1, 2]} />
					) : (
						<span class="placeholder" aria-hidden="true">
							{project.data.name[0]}
						</span>
					)}
					<span>{project.data.name}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	ul {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		text-decoration: none;
	}

	img,
	.placeholder {
		flex: none;
		width: 28px;
		height: 28px;
		border-radius: 0.375rem;
	}

	.placeholder {
		display: grid;
		place-items: center;
		background: var(--mat-raised);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}
</style>
