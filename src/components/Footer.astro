---
import { type Lang, localizePath, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
	{ href: 'https://github.com/ugurcaneser', label: 'GitHub' },
	{ href: 'https://linkedin.com/in/ugurcaneser', label: 'LinkedIn' },
	{ href: 'mailto:ugurcaneser@yahoo.com', label: t('footer.email') },
	{ href: localizePath(lang, '/rss.xml'), label: t('footer.rss') },
];
---

<footer>
	<div class="inner">
		<p class="label">© {new Date().getFullYear()} {t('site.title')}</p>
		<ul>
			{
				links.map((link) => (
					<li>
						<a class="label" href={link.href}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<style>
	footer {
		margin-top: 6rem;
		border-top: 1px solid var(--line);
		background: var(--mat);
	}

	.inner {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 82rem;
		margin: 0 auto;
		padding: 2rem var(--gutter) 2.5rem;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		text-decoration: none;
	}

	a:hover {
		color: var(--marker);
	}

	@media (min-width: 48rem) {
		.inner {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
	}
</style>
