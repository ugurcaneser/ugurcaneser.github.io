---
import { type Lang, localizePath, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
	{ href: 'https://github.com/ugurcaneser', label: 'GitHub' },
	{ href: 'https://linkedin.com/in/ugurcaneser', label: 'LinkedIn' },
	{ href: 'mailto:ugurcaneser@yahoo.com', label: t('footer.email') },
	{ href: localizePath(lang, '/rss.xml'), label: t('footer.rss') },
];
---

<footer class="container">
	<ul>
		{
			links.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))
		}
	</ul>
</footer>

<style>
	footer {
		padding-top: 4rem;
		padding-bottom: 3rem;
		font-size: 0.875rem;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 0;
		padding: 1.5rem 0 0;
		border-top: 1px solid var(--border);
		list-style: none;
	}

	a {
		color: var(--muted);
		text-decoration: none;
	}

	a:hover {
		color: var(--text);
	}
</style>
