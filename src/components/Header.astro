---
import { type Lang, langs, localizePath, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
	translations: Partial<Record<Lang, string>>;
}

const { lang, translations } = Astro.props;
const t = useTranslations(lang);
const otherLang = langs.find((l) => l !== lang)!;
const switchHref = translations[otherLang] ?? localizePath(otherLang, '/');

const home = localizePath(lang, '/');
const nav = [
	{ href: home, label: t('nav.posts') },
	{ href: localizePath(lang, '/projects/'), label: t('nav.projects') },
	{ href: localizePath(lang, '/tags/'), label: t('nav.tags') },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === home ? path === home || path.startsWith(localizePath(lang, '/posts/')) : path.startsWith(href);
---

<header class="container">
	<a class="brand" href={home}>{t('site.title')}</a>
	<nav aria-label={t('nav.label')}>
		{
			nav.map((item) => (
				<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
		<a href={switchHref} hreflang={otherLang} lang={otherLang} title={t('lang.switch')}>
			{otherLang.toUpperCase()}
		</a>
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-top: 1.5rem;
		padding-bottom: 1.5rem;
	}

	.brand {
		font-weight: 600;
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 1.25rem;
		font-size: 0.9375rem;
	}

	nav a {
		color: var(--muted);
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--text);
	}
</style>
