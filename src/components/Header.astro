---
import { type Lang, langs, localizePath, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
	translations: Partial<Record<Lang, string>>;
}

const { lang, translations } = Astro.props;
const t = useTranslations(lang);
const otherLang = langs.find((l) => l !== lang)!;
const switchHref = translations[otherLang] ?? localizePath(otherLang, '/');

const home = localizePath(lang, '/');
const nav = [
	{ href: home, label: t('nav.posts') },
	{ href: localizePath(lang, '/projects/'), label: t('nav.projects') },
	{ href: localizePath(lang, '/tags/'), label: t('nav.tags') },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === home ? path === home || path.startsWith(localizePath(lang, '/posts/')) : path.startsWith(href);
---

<header>
	<div class="container bar">
		<a class="brand" href={home}>{t('site.title')}</a>
		<nav>
			{
				nav.map((item) => (
					<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="actions">
			<a class="lang" href={switchHref} hreflang={otherLang} lang={otherLang} title={t('lang.switch')}>
				{otherLang.toUpperCase()}
			</a>
			<button class="theme-toggle" type="button" aria-label={t('theme.toggle')} title={t('theme.toggle')}>
				<svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
				</svg>
				<svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>
		</div>
	</div>
</header>

<script>
	for (const button of document.querySelectorAll('.theme-toggle')) {
		button.addEventListener('click', () => {
			const root = document.documentElement;
			const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {}
		});
	}
</script>

<style>
	header {
		border-bottom: 1px solid var(--border);
	}

	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		padding-top: 1rem;
		padding-bottom: 1rem;
	}

	.brand {
		color: var(--text);
		font-weight: 700;
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 1rem;
		margin-right: auto;
	}

	nav a {
		color: var(--text-muted);
		font-size: 0.95rem;
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--text);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.lang {
		color: var(--text-muted);
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
	}

	.lang:hover {
		color: var(--text);
	}

	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 0.4rem;
		background: none;
		color: var(--text-muted);
		cursor: pointer;
	}

	.theme-toggle:hover {
		color: var(--text);
	}

	.theme-toggle svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	:global([data-theme='dark']) .sun,
	:global([data-theme='light']) .moon {
		display: none;
	}

	@media (max-width: 30rem) {
		nav {
			order: 3;
			width: 100%;
		}
	}
</style>
