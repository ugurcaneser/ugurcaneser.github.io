---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { formatDate, type Lang, useTranslations } from '../i18n';
import { type Post, postUrl, readingTime } from '../lib/content';

interface Props {
	lang: Lang;
	posts: Post[];
	/** Leave out the project icons, e.g. on a project's own page. */
	hideProject?: boolean;
}

const { lang, posts, hideProject = false } = Astro.props;
const t = useTranslations(lang);

const items = await Promise.all(
	posts.map(async (post) => ({
		post,
		project: !hideProject && post.data.project ? await getEntry(post.data.project) : undefined,
	})),
);
---

{
	posts.length === 0 ? (
		<p class="muted">{t('home.empty')}</p>
	) : (
		<ul class="posts">
			{items.map(({ post, project }) => (
				<li class:list={{ 'with-icon': !hideProject }}>
					{!hideProject &&
						(project?.data.icon ? (
							<Image class="icon" src={project.data.icon} alt="" width={40} height={40} densities={[1, 2]} />
						) : (
							<span class="icon" aria-hidden="true" />
						))}
					<div>
						<a href={postUrl(post)}>{post.data.title}</a>
						{post.data.draft && <span class="muted"> (draft)</span>}
						<p class="meta muted">
							{project && <span>{project.data.name} · </span>}
							<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
							<span> · {t('post.minRead', { n: readingTime(post) })}</span>
						</p>
						<p class="description muted">{post.data.description}</p>
					</div>
				</li>
			))}
		</ul>
	)
}

<style>
	.posts {
		display: grid;
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.with-icon {
		display: grid;
		grid-template-columns: 40px minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
	}

	.icon {
		display: block;
		width: 40px;
		height: 40px;
		margin-top: 0.2rem;
		border-radius: 22%;
		background: var(--bg-raised);
	}

	a {
		font-weight: 600;
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	.meta {
		margin: 0.125rem 0 0;
		font-size: 0.875rem;
	}

	.description {
		margin: 0.35rem 0 0;
		font-size: 0.9375rem;
	}
</style>
