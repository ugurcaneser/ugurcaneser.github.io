---
import { getEntry } from 'astro:content';
import { formatDate, type Lang, localizePath, useTranslations } from '../i18n';
import { type Post, postUrl, readingTime, tagUrl } from '../lib/content';

interface Props {
	lang: Lang;
	posts: Post[];
	/** Hide the project label, e.g. on a project's own page. */
	hideProject?: boolean;
}

const { lang, posts, hideProject = false } = Astro.props;
const t = useTranslations(lang);

const items = await Promise.all(
	posts.map(async (post) => ({
		post,
		project: !hideProject && post.data.project ? await getEntry(post.data.project) : undefined,
	})),
);
---

{
	posts.length === 0 ? (
		<p class="muted">{t('home.empty')}</p>
	) : (
		<ol class="posts">
			{items.map(({ post, project }) => (
				<li>
					<article>
						<p class="meta label">
							<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
							<span>{t('post.minRead', { n: readingTime(post) })}</span>
							{post.data.draft && <span class="draft">draft</span>}
						</p>
						<div class="text">
							{project && (
								<a class="project label" href={localizePath(lang, `/projects/${project.id}/`)}>
									{project.data.name}
								</a>
							)}
							<h2>
								<a href={postUrl(post)}>{post.data.title}</a>
							</h2>
							<p class="description">{post.data.description}</p>
							{post.data.tags.length > 0 && (
								<ul class="tags">
									{post.data.tags.map((tag) => (
										<li>
											<a class="tag" href={tagUrl(lang, tag)}>
												{tag}
											</a>
										</li>
									))}
								</ul>
							)}
						</div>
					</article>
				</li>
			))}
		</ol>
	)
}

<style>
	.posts {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
		list-style: none;
	}

	.posts > li {
		padding: 1.75rem 0;
		border-bottom: 1px solid var(--line);
	}

	article {
		display: grid;
		gap: 0.5rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}

	.project {
		display: inline-block;
		margin-bottom: 0.25rem;
		color: var(--marker);
		text-decoration: none;
	}

	.project:hover {
		text-decoration: underline;
	}

	h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 1.3rem + 2vw, 2.5rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: 0.005em;
		text-wrap: balance;
	}

	h2 a {
		text-decoration: none;
	}

	/* The whole card is clickable through the title link. */
	article {
		position: relative;
	}

	h2 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.project,
	.tags {
		position: relative;
		z-index: 1;
	}

	.description {
		max-width: var(--measure);
		margin: 0.5rem 0 0.875rem;
		color: var(--sage);
		text-wrap: pretty;
	}

	.draft {
		padding: 0 0.375rem;
		border-radius: 0.2rem;
		background: var(--marker);
		color: var(--mat);
	}

	@media (min-width: 48rem) {
		.posts > li {
			padding: 2.25rem 0;
		}

		article {
			grid-template-columns: 9.5rem minmax(0, 1fr);
			gap: 2rem;
		}

		.meta {
			flex-direction: column;
			padding-top: 0.25rem;
		}
	}
</style>
